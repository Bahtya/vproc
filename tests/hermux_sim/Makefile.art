# Makefile.art — ART test APK for vproc issue #28 debugging
#
# Build:     make -f Makefile.art
# Install:   make -f Makefile.art install    (pm install, no ADB needed)
# Run:       make -f Makefile.art test       (curl /run)
# Results:   make -f Makefile.art results    (curl /results)

JAVA_HOME ?= /data/data/com.termux/files/usr/lib/jvm/java-21-openjdk
D8        = /data/data/com.termux/files/usr/bin/bash \
              /data/data/com.termux/files/home/android-sdk/build-tools/35.0.0/d8
JAVAC     = javac
KEYTOOL   = $(JAVA_HOME)/bin/keytool
CFLAGS    = -Wall -Wextra -O2 -fPIC \
            -I$(JAVA_HOME)/include -I$(JAVA_HOME)/include/linux
LDFLAGS   = -shared -lutil -landroid

LIBDIR    = ../../target/debug
BUILDDIR  = build_art
SDK_PLATFORM = /data/data/com.termux/files/home/android-sdk/platforms/android-36/android.jar

PACKAGE   = com.vproc.arttest
PORT      = 18080

.PHONY: all install clean test results log status ping run

all: $(BUILDDIR)/art_test.apk

# --- Build ---

$(BUILDDIR)/libvproc_jni_bridge.so: vproc_jni_bridge.c
	mkdir -p $(BUILDDIR)
	clang $(CFLAGS) $(LDFLAGS) -o $@ $<

$(BUILDDIR)/.classes: TestTermuxSession.java ArtTestActivity.java TestRunnerService.java HttpServerService.java
	mkdir -p $(BUILDDIR)/classes
	$(JAVAC) -d $(BUILDDIR)/classes \
		-cp $(SDK_PLATFORM) -source 11 -target 11 \
		TestTermuxSession.java ArtTestActivity.java TestRunnerService.java HttpServerService.java
	touch $@

$(BUILDDIR)/classes.dex: $(BUILDDIR)/.classes
	$(D8) --output $(BUILDDIR) --lib $(SDK_PLATFORM) \
		$$(find $(BUILDDIR)/classes -name '*.class')

$(BUILDDIR)/BuildArtApk.class: BuildArtApk.java | $(BUILDDIR)
	$(JAVAC) -d $(BUILDDIR) $<

debug.keystore:
	$(KEYTOOL) -genkeypair -v -keystore $@ \
		-alias arttest -keyalg RSA -keysize 2048 -validity 10000 \
		-storepass android -key-pass android \
		-dname "CN=ArtTest,O=Vproc,C=US"

$(BUILDDIR)/unsigned.apk: $(BUILDDIR)/BuildArtApk.class $(BUILDDIR)/classes.dex \
                           $(BUILDDIR)/libvproc_jni_bridge.so \
                           $(LIBDIR)/libvproc.so \
                           libsh.so libbash.so libandroid-support.so libiconv.so \
                           libreadline.so libncursesw.so
	java -cp $(BUILDDIR) BuildArtApk $@ --generate \
		$(BUILDDIR)/classes.dex \
		$(BUILDDIR)/libvproc_jni_bridge.so \
		$(LIBDIR)/libvproc.so \
		libsh.so libbash.so libandroid-support.so \
		libiconv.so libreadline.so libncursesw.so

$(BUILDDIR)/art_test.apk: $(BUILDDIR)/unsigned.apk debug.keystore
	bash /data/data/com.termux/files/home/android-sdk/build-tools/35.0.0/apksigner sign \
		--ks debug.keystore --ks-pass pass:android --key-pass pass:android \
		--out $@ $<

$(BUILDDIR):
	mkdir -p $(BUILDDIR)

# --- Install (pm, no ADB) ---

install: $(BUILDDIR)/art_test.apk
	pm install -r -t $< || bash auto_install.sh $<

# --- HTTP endpoints ---

run:
	am start -n com.vproc.arttest/com.vproc.arttest.ArtTestActivity

test:
	curl -s --max-time 10 http://127.0.0.1:$(PORT)/run

results:
	curl -s --max-time 10 http://127.0.0.1:$(PORT)/results

log:
	curl -s --max-time 10 http://127.0.0.1:$(PORT)/log

status:
	curl -s --max-time 5 http://127.0.0.1:$(PORT)/status

ping:
	curl -s --max-time 5 http://127.0.0.1:$(PORT)/ping

clean:
	rm -rf $(BUILDDIR)
	mkdir -p $(BUILDDIR)
